{
  "manifest_version": 3,
  "name": "SideMarks",
  "version": "2.28.5",
  "description": "右側のサイドパネルで、よく見るページをジャンルやフォルダに整理してすばやく開けます。",
  "permissions": ["storage", "unlimitedStorage", "tabs", "sidePanel", "contextMenus", "favicon", "clipboardRead"],
  "optional_host_permissions": ["https://*.gamewith.jp/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SideMarksを開く"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
